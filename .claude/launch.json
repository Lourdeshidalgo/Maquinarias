{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "gestion-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "gestion-dev-local",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "-p",
        "3100"
      ],
      "port": 3100,
      "env": {
        "DATABASE_URL": "postgresql://postgres:postgres@localhost:5433/gestion",
        "DIRECT_URL": "postgresql://postgres:postgres@localhost:5433/gestion"
      }
    }
  ]
}